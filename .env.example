# ─────────────────────────────────────────────────────────────
#  RaPaX™ Discord Bot — Environment Configuration
# ─────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Guild ID for instant slash command registration during dev.
# Remove or leave blank for global registration (takes ~1hr).
DISCORD_GUILD_ID=your_guild_id_here

# ── RaPaX™ API ────────────────────────────────────────────────
# URL where your RaPaX™ server is running
RAPAX_API_URL=http://localhost:4000/api

# Operator secret for RaPaX™ (same as OPERATOR_SECRET in rapax .env)
RAPAX_OPERATOR_SECRET=change_this_to_a_long_random_string

# ── Bot Behaviour ─────────────────────────────────────────────
# How often (ms) the bot polls for payment confirmation
POLL_INTERVAL_MS=15000

# How long (ms) to keep polling before giving up
POLL_TIMEOUT_MS=3600000

# Channel ID where the product catalog embeds are posted.
# Leave blank to disable auto-catalog posting.
PRODUCT_CHANNEL_ID=

# Channel ID for operator transaction notifications (optional)
OPERATOR_LOG_CHANNEL_ID=
